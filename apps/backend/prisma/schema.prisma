generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  plan             String   @default("starter") // starter, professional, enterprise
  createdAt        DateTime @default(now())
  maxUsers         Int      @default(5)
  stripeCustomerId String?

  users            User[]
  items            Item[]
  vendors          Vendor[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceives PurchaseReceive[]
  bills            Bill[]
  payments         Payment[]
  vendorCredits    VendorCredit[]
  rfqs             Rfq[]
  bids             Bid[]
  awards           Award[]
  recurrences      BillRecurrence[]
  paymentBatches   PaymentBatch[]
}

model User {
  id           String       @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  mfaSecret    String?
  status       String       @default("invited") // active, invited, disabled
  createdAt    DateTime     @default(now())

  tenant       Organization @relation(fields: [tenantId], references: [id])
  roles        UserRole[]

  @@unique([tenantId, email])
}

model Role {
  id        String     @id @default(uuid())
  name      String     @unique // e.g., Admin, Manager, Approver, Vendor, Viewer
  
  userRoles UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id       String @id @default(uuid())
  userId   String
  roleId   String

  user     User   @relation(fields: [userId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Permission {
  id        String @id @default(uuid())
  action    String @unique // e.g., po:create, po:approve, vendor:manage
  
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Item {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  sku         String?
  category    String   @default("Other")
  unit        String   @default("PCS")
  costPrice   Float    @default(0)
  description String?
  status      String   @default("active")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, category])
}

model Vendor {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  category      String?  @default("General")
  paymentTerms  String?  @default("Net 15")
  status        String   @default("active")
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PurchaseRequest {
  id              String   @id @default(uuid())
  tenantId        String
  prNumber        String
  requestorId     String?
  expectedDate    DateTime?
  deliveryAddress String?
  reason          String?
  notes           String?
  reference       String?
  status          String   @default("draft") // draft, awaiting, approved, rejected, processed, cancelled, onhold
  approverId      String?
  rejectReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines           PurchaseRequestLine[]

  @@unique([tenantId, prNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model PurchaseRequestLine {
  id              String   @id @default(uuid())
  tenantId        String
  prId            String
  itemId          String?
  itemName        String
  category        String?  @default("Other")
  description     String?
  preferredVendor String?
  quantity        Float    @default(1)
  estimatedRate   Float    @default(0)
  discount        Float    @default(0)
  pr              PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
  @@index([tenantId])
}

// ── Phase 2/4: ERPNext-aligned procure-to-pay (PO → Receive → Bill → Payment) ──

model PurchaseOrder {
  id           String   @id @default(uuid())
  tenantId     String
  poNumber     String
  vendorId     String?
  vendorName   String   @default("")
  sourcePrId   String?
  status       String   @default("draft") // draft, pending, approved, issued, partially_received, received, partially_billed, billed, closed, cancelled
  expectedDate DateTime?
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines        PurchaseOrderLine[]
  receives     PurchaseReceive[]
  bills        Bill[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id          String  @id @default(uuid())
  tenantId    String
  poId        String
  prLineId    String?
  itemId      String?
  itemName    String
  category    String? @default("Other")
  description String?
  quantity    Float   @default(1)
  rate        Float   @default(0)
  receivedQty Float   @default(0)
  billedQty   Float   @default(0)
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([tenantId])
}

model PurchaseReceive {
  id         String   @id @default(uuid())
  tenantId   String
  grnNumber  String
  poId       String
  status     String   @default("draft") // draft, completed, cancelled
  billed     Boolean  @default(false)
  receivedAt DateTime?
  notes      String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  lines      PurchaseReceiveLine[]
  bills      Bill[]

  @@unique([tenantId, grnNumber])
  @@index([tenantId])
  @@index([poId])
}

model PurchaseReceiveLine {
  id        String  @id @default(uuid())
  tenantId  String
  receiveId String
  poLineId  String
  itemName  String
  quantity  Float
  receive   PurchaseReceive @relation(fields: [receiveId], references: [id], onDelete: Cascade)

  @@index([receiveId])
  @@index([tenantId])
}

model Bill {
  id           String   @id @default(uuid())
  tenantId     String
  billNumber   String
  vendorBillNo String?
  vendorId     String?
  vendorName   String   @default("")
  poId         String?
  receiveId    String?
  status       String   @default("draft") // draft, pending, open, partially_paid, paid, overdue, void, cancelled
  issueDate    DateTime?
  dueDate      DateTime?
  notes        String?
  amountPaid   Float    @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  po           PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  receive      PurchaseReceive? @relation(fields: [receiveId], references: [id], onDelete: SetNull)
  lines        BillLine[]
  payments     Payment[]

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model BillLine {
  id        String  @id @default(uuid())
  tenantId  String
  billId    String
  poLineId  String?
  itemName  String
  quantity  Float   @default(1)
  rate      Float   @default(0)
  bill      Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([tenantId])
}

model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  billId     String?
  vendorName String   @default("")
  amount     Float
  method     String?
  reference  String?
  paidAt     DateTime @default(now())
  createdBy  String?
  createdAt  DateTime @default(now())
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill       Bill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([billId])
}

model VendorCredit {
  id         String   @id @default(uuid())
  tenantId   String
  vendorName String
  amount     Float
  remaining  Float
  source     String   @default("excess") // excess, return, advance
  billId     String?
  notes      String?
  status     String   @default("open") // open, consumed
  createdAt  DateTime @default(now())
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, vendorName])
}

// ── Phase 3: RFQ + bids + awards (ERPNext RFQ/SQ + OpenProcurement-lite) ──

model Rfq {
  id        String   @id @default(uuid())
  tenantId  String
  rfqNumber String
  prId      String?
  status    String   @default("draft") // draft, submitted, awarded_partial, awarded, cancelled, expired
  dueDate   DateTime?
  message   String?
  terms     String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines     RfqLine[]
  vendors   RfqVendor[]
  bids      Bid[]
  awards    Award[]

  @@unique([tenantId, rfqNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model RfqLine {
  id       String  @id @default(uuid())
  tenantId String
  rfqId    String
  itemId   String?
  itemName String
  quantity Float   @default(1)
  unit     String? @default("PCS")
  needBy   DateTime?
  openQty  Float   @default(1)
  rfq      Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([tenantId])
}

model RfqVendor {
  id           String   @id @default(uuid())
  tenantId     String
  rfqId        String
  vendorId     String?
  vendorName   String
  contactEmail String?
  inviteToken  String?  @unique
  emailSent    Boolean  @default(false)
  quoteStatus  String   @default("pending") // pending, received
  rfq          Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([tenantId])
}

model Bid {
  id          String   @id @default(uuid())
  tenantId    String
  rfqId       String
  vendorId    String?
  vendorName  String
  status      String   @default("submitted") // submitted, withdrawn, expired
  currency    String?  @default("LKR")
  validTill   DateTime?
  totalAmount Float    @default(0)
  submittedAt DateTime @default(now())
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfq         Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lines       BidLine[]

  @@index([rfqId])
  @@index([tenantId])
}

model BidLine {
  id        String  @id @default(uuid())
  tenantId  String
  bidId     String
  rfqLineId String
  itemName  String
  quantity  Float
  unitPrice Float
  amount    Float   @default(0)
  leadDays  Int?
  note      String?
  bid       Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId])
  @@index([tenantId])
}

model Award {
  id        String   @id @default(uuid())
  tenantId  String
  rfqId     String
  status    String   @default("pending") // pending, active, cancelled
  reason    String?
  decidedBy String?
  createdAt DateTime @default(now())
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfq       Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lines     AwardLine[]

  @@index([rfqId])
  @@index([tenantId])
}

model AwardLine {
  id        String @id @default(uuid())
  tenantId  String
  awardId   String
  rfqLineId String
  bidLineId String
  quantity  Float
  price     Float
  award     Award @relation(fields: [awardId], references: [id], onDelete: Cascade)

  @@index([awardId])
  @@index([tenantId])
}

// ── Phase 4: recurring bills + payment batches ──

model BillRecurrence {
  id             String   @id @default(uuid())
  tenantId       String
  templateBillId String
  profileName    String
  frequency      String   @default("monthly") // weekly, monthly, quarterly, yearly
  startDate      DateTime @default(now())
  endDate        DateTime?
  nextRunDate    DateTime @default(now())
  disabled       Boolean  @default(false)
  status         String   @default("active") // active, completed, disabled
  createdAt      DateTime @default(now())
  tenant         Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PaymentBatch {
  id          String   @id @default(uuid())
  tenantId    String
  batchNumber String
  batchName   String?
  status      String   @default("draft") // draft, processed, cancelled
  paidThrough String?
  paymentDate DateTime?
  reference   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines       PaymentBatchLine[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId])
}

model PaymentBatchLine {
  id        String @id @default(uuid())
  tenantId  String
  batchId   String
  billId    String
  amount    Float
  status    String @default("pending") // pending, paid, failed
  batch     PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([tenantId])
}
