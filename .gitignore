# Dependencies — reinstalled from package.json, never committed.
node_modules/

# Secrets. The Books OAuth client secret and anything like it lives in the
# function's Catalyst environment variables, never in the repo. .env.local is
# a convenience copy for pasting into the console — it must never be tracked.
.env
.env.*
!.env.example

# Build/deploy artifacts
*.zip
.catalyst/
.slate/

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# Scratch
y.txt

# Verification run output (regenerated by verification/uitest.mjs)
verification/shots-ui/

# React client build output (regenerated by `npm run build`)
frontend/dist/

# Scratch and caches
tmp/
.tmp_pdf_chrome*/
tools/__pycache__/
~$*

# Design mockups (Stitch) sit beside the repo for reference, not in it
Procurement Frontend/
